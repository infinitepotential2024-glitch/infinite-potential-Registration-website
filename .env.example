# From Supabase → Project Settings → API. Copy this file to .env.local
# for local development, and set the same three values in Vercel →
# Project → Settings → Environment Variables for production.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # "anon public" key — safe in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # "service_role" key — SERVER ONLY, never expose this
